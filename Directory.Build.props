<Project>
  <!--
    VERSION.txt là nguồn version DUY NHẤT cho toàn bộ solution.
    Chỉ sửa VERSION.txt (ví dụ 13.5.4 -> 13.5.5), sau đó build/publish lại.
  -->
  <PropertyGroup>
    <AppVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION.txt').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion).0</FileVersion>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>

    <!-- DPI: dùng Per-Monitor V2 cho cả Manager và Worker. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
</Project>
